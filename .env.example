# Backend Base API URL (Must end with /api)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production example on Vercel:
# NEXT_PUBLIC_API_URL=https://api.keytrustpay.org/api
# or:
# NEXT_PUBLIC_API_URL=https://your-backend-project.vercel.app/api
